# Copy to .env (git-ignored). Everything here can also be set in the app's Settings page, which wins over .env.

# Oracle Analytics Cloud instance (https://<instance>.analytics.ocp.oraclecloud.com)
OAC_URL=

# The model: provider:model. No default: set it here or in Settings.
#   openai:gpt-5.6-luna@low · anthropic:claude-sonnet-5 · oci:openai.gpt-oss-120b · custom:qwen3:14b
LLM_MODEL=

# Keys: only the one of your provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OCI_GENAI_API_KEY=
CUSTOM_LLM_API_KEY=

# OCI Generative AI (native API): compartment OCID, region (default eu-frankfurt-1)
OCI_COMPARTMENT_ID=
OCI_REGION=

# Your own OpenAI-compatible server (Ollama, vLLM, LM Studio…)
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1

# Optional: skeleton .dva for "Download .dva" (default .secrets/skeleton.dva)
# SKELETON_DVA=.secrets/skeleton.dva
# Optional: visual templates from your catalog instead of the bundled ones
# TEMPLATE_WORKBOOKS=Examples,Example 2,Varianti
# Optional: dev token for the terminal chat (written by: uv run python -m liveinsight.platforms.oac.login)
# OAC_TOKENS=.secrets/tokens.json
